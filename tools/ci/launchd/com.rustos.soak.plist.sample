<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd LaunchAgent — RustOS nightly 24 h soaks (parallel).

  Runs tools/ci/soak.sh, which fans every §19.6 fuzz harness and §19.7
  proptest model out into a parallel process. Install with:

    cp tools/ci/launchd/com.rustos.soak.plist.sample \
       ~/Library/LaunchAgents/com.rustos.soak.plist
    # edit the absolute paths below to match your checkout / user, then:
    launchctl load ~/Library/LaunchAgents/com.rustos.soak.plist

  StartCalendarInterval fires once a day at 02:00 local time. RunAtLoad is
  deliberately absent so loading the agent does not kick off a 24 h job.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.rustos.soak</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/ianhawkins/RustroverProjects/rustos/tools/ci/soak.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>RUSTOS_CI_SYNC</key>
        <string>1</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/ianhawkins/ci-logs/rustos/launchd-soak.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ianhawkins/ci-logs/rustos/launchd-soak.err.log</string>
</dict>
</plist>
