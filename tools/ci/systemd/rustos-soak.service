# systemd service — RustOS nightly 24 h soaks (parallel).
#
# Runs tools/ci/soak.sh, which fans every §19.6 fuzz harness and §19.7
# proptest model out into a parallel process sharing one 24 h wall clock.
# Pair it with rustos-soak.timer.
#
# Install (user unit; see rustos-ci.service for the full sequence):
#
#   cp tools/ci/systemd/rustos-soak.service ~/.config/systemd/user/
#   cp tools/ci/systemd/rustos-soak.timer   ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now rustos-soak.timer
#
# A 24 h soak must not be killed for "taking too long": TimeoutStartSec is
# disabled. Edit the absolute ExecStart path to match your checkout.

[Unit]
Description=RustOS nightly soaks (cargo xtask fuzz/proptest --soak, parallel)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=infinity
Environment=RUSTOS_CI_SYNC=1
ExecStart=%h/RustroverProjects/rustos/tools/ci/soak.sh
